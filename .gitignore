# ===================================
# Minecraft Paper Server - .gitignore
# ===================================

# Основные серверные JAR (слишком большие для GitHub >50MB)
paper.jar
paper-*.jar

# Кэш патчера Paper (>50MB каждый)
cache/

# Логи сервера
logs/
*.log
*.log.gz

# Временные данные LuckPerms (бинарная БД)
plugins/LuckPerms/luckperms-h2-v2.mv.db
plugins/LuckPerms/luckperms-h2-v2.trace.db

# База данных аккаунтов AuthMe (содержит пароли игроков!)
plugins/AuthMe/authme.db
plugins/AuthMe/*.db
plugins/AuthMe/data/
plugins/AuthMe/LimboPlayers/
plugins/AuthMe/backups/
plugins/AuthMe/GeoLite2-Country.mmdb

# Данные игроков EssentialsX
plugins/Essentials/userdata/
plugins/Essentials/mail.txt

# WorldEdit история операций
plugins/WorldEdit/sessions/

# Crash репорты
crash-reports/

# Системные файлы Windows
Thumbs.db
desktop.ini
